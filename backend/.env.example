APP_ENV=development
DATABASE_URL=mysql+pymysql://mirai:CHANGE_ME@localhost:3306/mirai_shakthi?charset=utf8mb4
JWT_SECRET=CHANGE_ME_to_a_long_random_string
JWT_EXPIRE_MINUTES=10080

# OTP: keep OTP_DEV_MODE=true only on your laptop. In production set it to false and configure MSG91.
OTP_DEV_MODE=true
