# AI: "none" = demo mode (no external AI calls). "anthropic" = use Claude via API key.
AI_PROVIDER=none
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

CORS_ORIGINS=http://localhost:5173,capacitor://localhost,https://localhost
